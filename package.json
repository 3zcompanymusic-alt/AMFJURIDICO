{
  "name": "amf-firma-legal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma web unificada AMF Firma Legal S.A.S. (sitio corporativo, formularios, panel administrativo con Google OAuth y API modular PostgreSQL/Neon).",
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build && node scripts/prerender.js",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "node --test server/tests/*.test.js",
    "db:init": "node scripts/init-db.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "lucide-react": "^0.344.0",
    "pg": "^8.13.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.1.0",
    "gh-pages": "^6.3.0",
    "vite": "^5.1.6"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
