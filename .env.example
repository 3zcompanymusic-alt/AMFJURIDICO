# ==============================================================================
# AMF FIRMA LEGAL S.A.S. - Variables de Entorno
# Copia este archivo como .env para desarrollo local.
# Nunca subas .env con secretos reales a Git.
# ==============================================================================

# ── Base de Datos PostgreSQL (Neon / local) ────────────────────────────────────
# Ejemplo Neon:
# DATABASE_URL=postgresql://usuario:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amf_juridico

# Opcional: solo si usas certificado autofirmado en PostgreSQL local
# DB_SSL_REJECT_UNAUTHORIZED=false

# ── Servidor Express (Render / Local) ──────────────────────────────────────────
PORT=4000
NODE_ENV=development

# En Cloudflare Pages (frontend separado) + Render (API separada), usa false en Render:
# SERVE_STATIC=false
SERVE_STATIC=true

# Orígenes permitidos para CORS separados por coma (sin barra final)
# Ejemplo producción: ALLOWED_ORIGINS=https://amfjuridico.com,https://www.amfjuridico.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Autenticación 100% Google OAuth (sin correos ni contraseñas en BD) ─────────
# Client ID obtenido en Google Cloud Console (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Secreto largo aleatorio (mínimo 32 caracteres) para firmar JWT de sesión admin
AUTH_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-en-produccion

# Código maestro de un solo uso inicial para vincular el primer SUPER_ADMIN con su Google ID
# Se desactiva automáticamente en cuanto exista el primer administrador registrado.
ADMIN_BOOTSTRAP_CODE=AMF-ADMIN-INICIAL-2026

# Opcional: dominio de cookie para compartir cookie HttpOnly entre amfjuridico.com y api.amfjuridico.com
# COOKIE_DOMAIN=.amfjuridico.com
# COOKIE_SAME_SITE=lax

# ── Frontend (Cloudflare Pages / Vite) ─────────────────────────────────────────
# Si Frontend está en Cloudflare Pages y Backend en Render, configura la URL pública del backend:
# VITE_API_URL=https://api.amfjuridico.com
VITE_API_URL=

# Base path del frontend (en dominio propio raíz dejar /)
VITE_BASE_PATH=/
